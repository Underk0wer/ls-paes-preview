# ==========================================================================
#  Limón Soda Zero — Configuración para servidores Apache / cPanel
#  (Se ignora sin problemas en Netlify, Vercel, GitHub Pages, Nginx, etc.)
# ==========================================================================

# Página de inicio por defecto
DirectoryIndex index.html

# --- Tipos MIME correctos (por si el host no los reconoce) ---
<IfModule mod_mime.c>
  AddType image/webp             .webp
  AddType image/svg+xml          .svg
  AddType video/mp4              .mp4
  AddType image/jpeg             .jpg .jpeg
  AddType image/png              .png
</IfModule>

# --- Compresión (texto/SVG; los videos y webp ya vienen comprimidos) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Caché del navegador para los estáticos ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html            "access plus 0 seconds"
  ExpiresByType text/css             "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp           "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/jpeg           "access plus 1 year"
  ExpiresByType video/mp4            "access plus 1 year"
</IfModule>
